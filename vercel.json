{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "crons": [
        {
            "path": "/api/keep-alive",
            "schedule": "0 8 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/dvla",
            "destination": "/api/dvla"
        },
        {
            "source": "/api/send-email",
            "destination": "/api/send-email"
        },
        {
            "source": "/api/keep-alive",
            "destination": "/api/keep-alive"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}